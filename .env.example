APP_NAME="LG Production Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

LOG_CHANNEL=stack

DB_CONNECTION=planta_a

DB_PLANTA_A_HOST=mysql_planta_a
DB_PLANTA_A_PORT=3306
DB_PLANTA_A_EXPOSED_PORT=3307
DB_PLANTA_A_DATABASE=planta_a
DB_PLANTA_A_USERNAME=lg_app
DB_PLANTA_A_PASSWORD=lg_app_secret_a
DB_PLANTA_A_ROOT_PASSWORD=root_secret_a

DB_PLANTA_B_HOST=mysql_planta_b
DB_PLANTA_B_PORT=3306
DB_PLANTA_B_EXPOSED_PORT=3308
DB_PLANTA_B_DATABASE=planta_b
DB_PLANTA_B_USERNAME=lg_app
DB_PLANTA_B_PASSWORD=lg_app_secret_b
DB_PLANTA_B_ROOT_PASSWORD=root_secret_b

SIMULATION_ENABLED=true
SIMULATION_DATE=2026-02-01
SIMULATION_INTERVAL_SECONDS=10
DASHBOARD_POLLING_INTERVAL_MS=5000

# Recurso opcional: análise gerencial com IA pela Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=20
GROQ_CACHE_SECONDS=300

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
